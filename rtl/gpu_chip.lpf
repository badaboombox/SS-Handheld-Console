# gpu_chip pinout - LFE5U-85F-CABGA381 (speed grade -8)
# Generated from ECP5U85Pinout.csv. Edge allocation:
#   SDRAM  -> banks 2/3 (right)   FMC -> banks 7/6 (left)
#   panel  -> banks 0/1 (top)     clk_ref -> A4 (ULC_GPLL0T_IN)
# Config (SPI flash/JTAG/PROGRAMN/DONE) uses dedicated bank-8 pins (automatic).

FREQUENCY PORT "clk_ref" 50.0 MHZ;

# clocks / reset
LOCATE COMP "clk_ref" SITE "A4";  # PL11A (left bank6/7)
IOBUF  PORT "clk_ref" IO_TYPE=LVCMOS33 PULLMODE=NONE;
LOCATE COMP "rst" SITE "G2";  # PL47A (left bank6/7)
IOBUF  PORT "rst" IO_TYPE=LVCMOS33;

